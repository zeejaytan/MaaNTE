        "rate_limit": 0
    },

    // GFN 云游戏：钓鱼买饵/卖鱼/商店等 Pipeline 层模板匹配统一放宽阈值
    // （默认 0.70→0.50，原严格 0.80→0.60）。奥托钓鱼小游戏内部识别由
    // agent 侧 match_template_in_region 在云端模式自动放宽，无需在此覆盖。
    "FishNewChooseGeneralBait": {
        "desc": "找到并选中万能鱼饵",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    389,
                    293,
                    494,
                    135
                ],
                "template": "Fish/FishGeneralBait.png",
                "threshold": 0.5
            }
        },
        "next": [
            "[JumpBack]FishNewBaitDetail",
            "FishNewUseBait",
            "FishNewGotoBuyBait",
            "FishNewBaitExit"
        ],
        "on_error": [
            "[Anchor]FishNewErrorRestart"
        ]
    },

