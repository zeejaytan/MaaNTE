    "PinkPawHeist_OCR_Join": {
        // GFN 下对话选项列表整体上移约 25px，原 ROI [869,313,304,51] 落在「兑换商店」行，
        // OCR 读不到「我要参加」。动作为 ClickKey(F) 的确认门，命中位置无关紧要，
        // 故纵向放宽 ROI 以同时覆盖桌面端(y313)与 GFN(y288) 两个位置。
        "desc": "OCR识别我要参加（GFN ROI 纵向放宽以适配对话选项上移）",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "我加入。",
                    "(?i)Count\\s*me\\s*in\\s*\\.",
                    "参加する",
                    "我要参加",
                    "I'm in",
                    "참가하기"
                ],
                "roi": [
                    869,
                    283,
                    320,
                    90
                ]
            }
        },
        "pre_delay": 500,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 70
            }
        },
        "next": [
            "PinkPawHeist_SkipStory_Join"
        ]
    }
