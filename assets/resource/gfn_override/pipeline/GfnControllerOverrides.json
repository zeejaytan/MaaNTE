{
    // GFN 云游戏专用覆盖层。
    // 通过 interface.json 中「官服-GFN」资源包以 [resource/base, resource/gfn_override]
    // 顺序加载，后加载的同名节点覆盖 base，仅在选择该资源包时生效，不影响桌面端。
    //
    // 背景：GeForce NOW 串流经过重编码 + 强制画质预设（NVIDIA 已公开承认云端无法进入
    // 游戏内画质设置），HUD 图标为半透明叠加层，导致模板匹配分数整体较桌面端低约 0.1，
    // 稳定低于为原生客户端标定的默认阈值 0.70。实测（1280x720 干净截图）：
    //   EscMenuButton  : 0.65（钓鱼台）/ 0.77（粉爪大厅）
    //   TasksMenuButton: 0.46（各场景一致）
    // 重新采集 GFN 模板无法跨场景泛化（半透明图标随背景变化），故此处放宽阈值，
    // 依赖 InWorld = And[Esc, Tasks] 双按钮固定 ROI 同时命中来抑制误报。

    "EscMenuButton": {
        "desc": "大世界中的ESC菜单按钮（GFN 阈值放宽 0.70→0.60）",
        "recognition": "TemplateMatch",
        "roi": [
            1208,
            5,
            60,
            60
        ],
        "template": [
            "Common/Button/InWorld/EscPhone.png",
            "Common/Button/InWorld/EscPhoneWithRedDot.png"
        ],
        "green_mask": true,
        "threshold": 0.6,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AltClickEscMenuButtonKeyDown"
        ]
    },

    "TasksMenuButton": {
        "desc": "大世界中的任务菜单按钮（GFN 阈值放宽 0.70→0.42）",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            105,
            60,
            60
        ],
        "template": [
            "Common/Button/InWorld/Tasks.png",
            "Common/Button/InWorld/TasksWithRedDot.png"
        ],
        "green_mask": true,
        "threshold": 0.42,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AltClickTasksMenuButtonKeyDown"
        ]
    },

    "FishSceneOnFishPrepare": {
        // GFN 下钓鱼准备界面标题「钓鱼准备」较桌面端上移约 24px，原 ROI [821,39,252,51]
        // 落在下方的钓点名（如「水菱湖钓点」）上，读不到标题。上移并放宽 ROI 覆盖标题；
        // OCR 按 expected 过滤，捕获到多余文字无害。
        "desc": "判断正在钓鱼准备界面（GFN ROI 上移覆盖「钓鱼准备」标题）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    775,
                    15,
                    165,
                    50
                ],
                "expected": [
                    "钓鱼准备",
                    "釣魚準備",
                    "(?i)Fishing\\s*Preparations",
                    "釣り準備"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },

    "FishSceneHookButton": {
        // 钓鱼小游戏鱼钩按钮(F)。GFN 半透明图标模板匹配约 0.60，低于默认 0.70。
        "desc": "鱼钩按钮(F)（GFN 阈值放宽 0.70→0.50）",
        "recognition": "TemplateMatch",
        "roi": [
            1137,
            600,
            100,
            100
        ],
        "template": [
            "Fish/FishGameSign.png",
            "Fish/FishGameSignThinner.png"
        ],
        "green_mask": true,
        "threshold": 0.5,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },

    "FishSceneBaitButton": {
        // 钓鱼小游戏鱼饵按钮(E)。GFN 下约 0.71 勉强过线，放宽阈值留余量。
        "desc": "鱼饵按钮(E)（GFN 阈值放宽 0.70→0.50）",
        "roi": [
            1044,
            600,
            100,
            100
        ],
        "recognition": "TemplateMatch",
        "template": [
            "Fish/FishGameSign2.png"
        ],
        "green_mask": true,
